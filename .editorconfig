root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csproj,sln,props,targets,ps1}]
end_of_line = crlf

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.{md,sha256}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
